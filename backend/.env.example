# Configurações do Backend - Tutor de Estudos com IA
# Copie este arquivo para .env na pasta backend/

# Chave gratuita do Google AI Studio (https://aistudio.google.com/apikey)
# Se não informada, o sistema funcionará em Modo de Demonstração identificado.
GEMINI_API_KEY=

# Configurações do servidor
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
